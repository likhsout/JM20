# Supabase — Create project at https://supabase.com (Singapore region)
# Then Project Settings → API → copy these 2 values → paste into .env.local

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Optional: for migration script (service role, keep secret — never commit)
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...
